# Copy these variables to back/.env. Keep provider keys out of source control.
NVIDIA_API_KEY=replace-with-a-new-NVIDIA-key
GEMINI_API_KEY=replace-with-a-new-Google-AI-Studio-key

# Optional overrides
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
GEMINI_QUERY_MODEL=gemini-3.5-flash-lite
SEARCH_MIN_COSINE=0.20
